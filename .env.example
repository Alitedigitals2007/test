# Postgres connection string.
# On Vercel: Storage → Neon sets DATABASE_URL automatically once the database is linked.
# For local development, e.g. a Docker Postgres:
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/renaissance
DATABASE_URL=

# Admin password for /admin — choose something long and unique.
ADMIN_PASSWORD=

# Secret used to sign the admin session cookie. Use a long random string (48+ chars).
# Tip: openssl rand -hex 32
ADMIN_SESSION_SECRET=

# Optional: canonical site URL, used for metadata and Open Graph tags.
# NEXT_PUBLIC_SITE_URL=https://your-site.vercel.app
